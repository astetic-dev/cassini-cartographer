{
  "template": "flow-rails",
  "stations": [
    {
      "id": "described",
      "title": "How you describe it",
      "sub": "a process, a body of work",
      "col": 0
    },
    {
      "id": "method",
      "title": "icm-architect",
      "sub": "the method, written down",
      "col": 1
    },
